# ---------------------------------------------------------------------------
# Genesis Track Fest — environment variables
# Copy to .env.local and fill in from your Supabase project:
#   Supabase Dashboard → Project Settings → API
# The PUBLIC site renders from seed data even with these unset; the admin
# panel, auth, uploads and live content require them.
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose this. Used for privileged server actions
# (e.g. deleting Storage objects alongside DB rows). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
